@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false

enum StatusLote {
  MONTAGEM
  EM_ROTA
  CONCLUIDO
}

enum StatusEncomenda {
  NO_CD
  EM_ROTA
  ENTREGUE
  FALHA
}

enum TipoEvento {
  EM_ROTA
  AVISO_ENVIADO
  ENTREGUE
  FALHA
}

enum TipoUsuario {
  ENTREGADOR
  CLIENTE
}

enum StatusEntregador {
  DISPONIVEL
  INDISPONIVEL
}


abstract class Usuario {
  - String dsEmail
  - String dsSenhaHash
  --
  + {abstract} int getId()
  + {abstract} String getNome()
  + {abstract} TipoUsuario getTipo()
}

class CentroDistribuicao {
  - int cdCentro
  - String nmCentro
  - String dsEndereco
  - Double vlLatitude
  - Double vlLongitude
}

class Regiao {
  - int cdRegiao
  - String nmRegiao
}


class Entregador{
  - int cdEntregador
  - String nmEntregador
  - String nrTelefone
  - StatusEntregador status
  --
  + int getId()
  + String getNome()
  + TipoUsuario getTipo()
  + boolean estaDisponivel()
}

class Lote {
  - int cdLote
  - int cdCentro
  - int cdEntregador
  - String codigoQr
  - StatusLote status
  - LocalDateTime dtCriacao
  - LocalDateTime dtInicioRota
  - Double vlLatitudeAtual
  - Double vlLongitudeAtual
  --
  + boolean podeIniciarRota()
  + boolean estaEmRota()
  + boolean temPosicaoAtual()
}

class Cliente {
  - int cdCliente
  - int cdRegiao
  - String nmCliente
  - String nrWhatsapp
  - String dsEndereco
  - Double vlLatitude
  - Double vlLongitude
  --
  + int getId()
  + String getNome()
  + TipoUsuario getTipo()
}

class Encomenda {
  {static} - int PARADAS_AVISO = 3
  - int cdEncomenda
  - int cdCentro
  - int cdLote
  - int cdCliente
  - String codigoRastreio
  - Integer nrPosicaoRota
  - StatusEncomenda status
  --
  + boolean estaAtiva()
  + boolean foiEntregue()
  + int calcularParadasRestantes(int entregasConcluidas)
  + boolean deveAvisarCliente(int paradasRestantes)
}

class EventoRastreio {
  - int cdEvento
  - int cdEncomenda
  - TipoEvento tipo
  - LocalDateTime dtEvento
  --
  + boolean ehAviso()
}

Usuario <|-- Entregador
Usuario <|-- Cliente

CentroDistribuicao "1" --> "0..*" Lote : possui
CentroDistribuicao "1" --> "0..*" Encomenda : recebe
Regiao "1" --> "0..*" Cliente : abrange
Entregador "*" -- "*" Regiao : atua em
Entregador "1" --> "0..*" Lote : percorre
Lote "1" --> "0..20" Encomenda : contém
Cliente "1" --> "0..*" Encomenda : recebe
Encomenda "1" --> "0..*" EventoRastreio : gera

Lote ..> StatusLote
Encomenda ..> StatusEncomenda
EventoRastreio ..> TipoEvento
Usuario ..> TipoUsuario
Entregador ..> StatusEntregador

note right of Lote
  O Java cria o lote junto com a
  atribuição: cada entregador tem
  no máximo 20 entregas ativas.
  codigoQr é o texto que vira o QR
  (a imagem é gerada pelo Python).
  vlLatitudeAtual e vlLongitudeAtual
  guardam a posição do entregador
  para o mapa do cliente.
end note

note bottom of Encomenda
  Ao ser bipada no CD, o Java escolhe
  um entregador da região do cliente
  que esteja DISPONIVEL, fora de rota
  e com vaga, e já liga a encomenda
  ao lote dele (cdLote preenchido na
  criação). nrPosicaoRota só é
  calculado quando o entregador lê o QR.
  PARADAS_AVISO é o limite de paradas
  restantes para avisar o cliente.
end note

note bottom of Entregador
  O entregador nasce INDISPONIVEL e
  ativa o perfil quando estiver pronto
  para fazer entregas. Não pode ficar
  indisponível com uma rota em andamento.
end note

note right of Usuario
  Entregador e Cliente herdam e-mail
  e hash da senha. dsSenhaHash guarda
  o hash (nunca a senha em texto) e
  não aparece em nenhuma resposta da
  API. No banco continuam sendo duas
  tabelas separadas, cada uma com
  suas colunas de e-mail e senha.
end note

note bottom of Regiao
  Entregador x Regiao é N:N.
  No banco vira a tabela associativa
  TB_ENTREGADOR_REGIAO.
end note

note as NotaGeral
  Getters, setters e construtores
  são gerados pelo Lombok e não
  aparecem no diagrama.
end note

@enduml
